rules_version = '2';

// แอปอ่าน/เขียน Firestore จากเบราว์เซอร์โดยตรงในชื่อผู้ใช้ที่ล็อกอิน (ข้อมูลทั้งหมดอยู่ใต้ Cmg-Cons-Page-Claude/root)
// - ทุกคอลเลกชัน: ผู้ใช้ที่ล็อกอินแล้วอ่าน/เขียนได้ (เหมือนเดิม — แอปตรวจสิทธิ์ตาม Role ฝั่งหน้าเว็บ)
// - menus (เมนูเพิ่มเติมใน sidebar): ผู้ใช้ที่ล็อกอินอ่านได้ แต่สร้าง/แก้/ลบได้เฉพาะ MasterAdmin ที่อนุมัติแล้ว
// - formStandards (คลังมาตรฐานแบบฟอร์มกลาง): ผู้ใช้ที่ล็อกอินอ่านได้ แต่สร้าง/แก้/ลบได้เฉพาะ MasterAdmin หรือ Admin ที่อนุมัติแล้ว
//   (การเลือกแบบฟอร์มให้โครงการ เขียนที่เอกสารโครงการ projects/{id}.form_standards จึงไม่ติด rule นี้)
//
// หมายเหตุ: rule ใน Firestore เป็นแบบ OR — ถ้ามี match ใดอนุญาต ก็ผ่าน จึงต้องตัดคอลเลกชันเหล่านี้ออกจาก match กว้างด้วย
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/Cmg-Cons-Page-Claude/root/users/$(request.auth.token.email.lower())).data;
    }

    function hasApprovedRole(roles) {
      return signedIn()
        && request.auth.token.email != null
        && me().status == 'approved'
        && me().role.hasAny(roles);
    }

    function isApprovedAdmin() {
      return hasApprovedRole(['MasterAdmin', 'Admin']);
    }

    function isApprovedMasterAdmin() {
      return hasApprovedRole(['MasterAdmin']);
    }

    function canUseProject(projectId) {
      return isApprovedAdmin()
        || (me().assignedProjects is list && me().assignedProjects.hasAny([projectId]));
    }

    function validMailRequest() {
      return request.resource.data.kind == 'daily_report'
        && request.resource.data.project_id is string
        && request.resource.data.report_date is string
        && request.resource.data.created_by == request.auth.token.email.lower()
        && request.resource.data.created_at == request.time
        && request.resource.data.to is list
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() <= 20
        && (!('cc' in request.resource.data) || (request.resource.data.cc is list && request.resource.data.cc.size() <= 20))
        && request.resource.data.message is map
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() > 0
        && request.resource.data.message.subject.size() <= 500
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 100000
        && request.resource.data.message.html is string
        && request.resource.data.message.html.size() <= 200000
        && exists(/databases/$(database)/documents/Cmg-Cons-Page-Claude/root/projects/$(request.resource.data.project_id));
    }

    match /Cmg-Cons-Page-Claude/root {
      allow read, write: if signedIn();

      match /{col}/{rest=**} {
        allow read: if signedIn();
        allow write: if signedIn() && !(col in ['menus', 'formStandards', 'mail', 'projects']);
      }

      match /projects/{projectId} {
        allow write: if signedIn();
        match /{section}/{rest=**} {
          allow write: if signedIn() && !(section in ['material_requests', 'document_setup', 'overview_embed']);
        }
        match /overview_embed/{configId} {
          allow write: if isApprovedMasterAdmin() && configId == 'scurve';
        }
        match /document_setup/{configId} {
          allow write: if configId == 'material'
            && hasApprovedRole(['MasterAdmin', 'Admin', 'ProjectManager', 'CM', 'Engineer'])
            && canUseProject(projectId);
        }
        match /material_requests/{requestId} {
          function requester() {
            return hasApprovedRole(['MasterAdmin', 'Admin', 'ProjectManager', 'CM', 'Engineer']) && canUseProject(projectId);
          }
          function blankSignatures() {
            return request.resource.data.submission is map
              && request.resource.data.submission.checked_by == ''
              && request.resource.data.submission.approved_by == ''
              && request.resource.data.submission.reviewed_by == '';
          }
          allow create: if requester()
            && request.resource.data.created_by == request.auth.token.email.lower()
            && request.resource.data.workflow_status == 'pending_cm'
            && request.resource.data.workflow_version == 1
            && request.resource.data.approval_history == []
            && request.resource.data.receipts == []
            && blankSignatures();
          allow update: if requester() && (resource.data.created_by == request.auth.token.email.lower() || isApprovedMasterAdmin())
            && resource.data.workflow_status == 'draft'
            && request.resource.data.workflow_status in ['draft', 'pending_cm']
            && request.resource.data.workflow_version == resource.data.workflow_version + 1
            && blankSignatures()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'spec', 'area', 'unit', 'quantity', 'require_schedule', 'remark', 'submission', 'items', 'files', 'document_profile_id', 'document_profile_name', 'workflow_status', 'workflow_version', 'rejection_reason', 'updated_at', 'updated_by']);
          allow update: if requester()
            && (!('workflow_status' in resource.data) || resource.data.workflow_status == 'approved')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipts', 'updated_at', 'updated_by']);
          function reviewTransition() {
            let before = resource.data.workflow_status;
            let after = request.resource.data.workflow_status;
            return (before == 'pending_cm' && hasApprovedRole(['CM', 'MasterAdmin']) && after in ['draft', 'pending_pm'])
              || (before == 'pending_pm' && hasApprovedRole(['ProjectManager', 'MasterAdmin']) && after in ['draft', 'approved']);
          }
          function reviewerName() {
            return me().firstName != '' ? (me().lastName != '' ? me().firstName + ' ' + me().lastName : me().firstName)
              : (me().lastName != '' ? me().lastName : request.auth.token.email.lower());
          }
          function reviewRecord() {
            let data = request.resource.data;
            let old = resource.data;
            let entry = data.approval_history[data.approval_history.size() - 1];
            return data.approval_history == old.approval_history.concat([entry])
              && entry.email == request.auth.token.email.lower()
              && entry.name == reviewerName()
              && entry.stage == (old.workflow_status == 'pending_cm' ? 'CM' : 'PM')
              && entry.action == (data.workflow_status == 'draft' ? 'reject' : 'approve')
              && entry.reason == data.rejection_reason
              && data.rejection_reason is string && data.rejection_reason.size() <= 500
              && (data.workflow_status == 'draft' ? data.rejection_reason.size() > 0 : data.rejection_reason == '')
              && data.submission.diff(old.submission).affectedKeys().hasOnly(['checked_by', 'approved_by', 'reviewed_by'])
              && data.submission.reviewed_by == ''
              && (data.workflow_status == 'draft' ? (data.submission.checked_by == '' && data.submission.approved_by == '')
                : data.workflow_status == 'pending_pm' ? (data.submission.checked_by == reviewerName() && data.submission.approved_by == old.submission.approved_by)
                : (data.submission.approved_by == reviewerName() && data.submission.checked_by == old.submission.checked_by));
          }
          allow update: if canUseProject(projectId) && reviewTransition() && reviewRecord()
            && request.resource.data.workflow_version == resource.data.workflow_version + 1
            && request.resource.data.updated_by == request.auth.token.email.lower()
            && request.resource.data.updated_at == request.time
            && (request.resource.data.workflow_status != 'approved' || request.resource.data.email_status == 'pending')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflow_status', 'workflow_version', 'submission', 'rejection_reason', 'approval_history', 'updated_at', 'updated_by', 'email_status']);
          allow delete: if isApprovedMasterAdmin();
        }
      }

      match /menus/{menuId} {
        allow write: if isApprovedMasterAdmin();
      }

      match /formStandards/{formId} {
        allow write: if isApprovedAdmin();
      }

      match /mail/{mailId} {
        allow create: if hasApprovedRole(['MasterAdmin', 'Admin', 'ProjectManager', 'Engineer'])
          && canUseProject(request.resource.data.project_id)
          && validMailRequest();
        allow read: if isApprovedAdmin();
        allow update, delete: if isApprovedAdmin();
      }
    }
  }
}
