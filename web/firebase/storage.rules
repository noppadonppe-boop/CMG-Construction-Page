rules_version = '2';

// รูปหน้างานอัปโหลดและเปิดดูผ่าน server เท่านั้น (เปิดดูด้วย signed URL อายุ 1 ชั่วโมง)
// ยกเว้นไอคอนของเมนูเพิ่มเติม: ผู้ใช้ที่ล็อกอินอ่านได้ อัปโหลด/ลบได้เฉพาะ MasterAdmin หรือ Admin ที่อนุมัติแล้ว
// (ไฟล์รูป PNG / WebP ไม่เกิน 200 KB — หน้าเว็บย่อเหลือ 128px ก่อนอัปโหลด)
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /Cmg-Cons-Page-Claude/root/menus/icons/{fileName} {
      function isApprovedAdmin() {
        let me = firestore.get(/databases/(default)/documents/Cmg-Cons-Page-Claude/root/users/$(request.auth.token.email.lower())).data;
        return request.auth != null
          && request.auth.token.email != null
          && me.status == 'approved'
          && me.role.hasAny(['MasterAdmin', 'Admin']);
      }

      allow read: if request.auth != null;
      allow delete: if isApprovedAdmin();
      allow create, update: if isApprovedAdmin()
        && request.resource.size < 200 * 1024
        && request.resource.contentType.matches('image/(png|webp)');
    }
  }
}
