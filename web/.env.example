# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Firebase Console > Project settings > General > Your apps (Web app)
# ถ้าไม่ใส่ค่า แอปจะทำงานใน "โหมดตัวอย่าง" ด้วยข้อมูลจำลอง
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL ของ backend ที่ส่งอีเมลด้วย SMTP (ตอนพัฒนาใช้ค่าเริ่มต้น http://localhost:3001 ได้)
NEXT_PUBLIC_MAIL_API_URL=http://localhost:3001

# ปลายทางของหน้า /material-request (ระบบ Material Request ภายนอก) — ใส่ URL เต็ม
NEXT_PUBLIC_MATERIAL_REQUEST_URL=

# SMTP email settings for backend — ห้ามใส่ค่านี้ใน NEXT_PUBLIC_* และห้าม commit ค่าใช้งานจริง
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-company-mail@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
MAIL_FROM=your-company-mail@gmail.com

# Backend server
PORT=3001
FRONTEND_APP_URL=http://localhost:3000

# Firebase Admin — ใช้อย่างใดอย่างหนึ่งสำหรับตรวจ Firebase ID token ของผู้ใช้ backend
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# หรือใช้ค่าจาก service account โดยตรง (private key ต้องเก็บเป็นตัวแปรลับ)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
